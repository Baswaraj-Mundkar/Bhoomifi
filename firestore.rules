rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function farmOwner(farmId) {
      return signedIn()
        && get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid;
    }

    function deviceOwner(deviceId) {
      return signedIn()
        && farmOwner(get(/databases/$(database)/documents/devices/$(deviceId)).data.farmId);
    }

    function deviceIdentity(deviceId) {
      return signedIn()
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.deviceUid == request.auth.uid;
    }

    function numericValue(value) {
      return value is int || value is float;
    }

    function validSensorFields(data) {
      return numericValue(data.soilMoisture)
        && data.soilMoisture >= 0 && data.soilMoisture <= 100
        && numericValue(data.soilRawADC)
        && data.soilRawADC >= 0 && data.soilRawADC <= 4095
        && numericValue(data.temperature)
        && data.temperature >= 0 && data.temperature <= 50
        && numericValue(data.humidity)
        && data.humidity >= 0 && data.humidity <= 100
        && numericValue(data.light)
        && data.light >= 0 && data.light <= 65535;
    }

    function validReading(data) {
      return data.keys().hasAll([
          'soilMoisture', 'soilRawADC', 'temperature', 'humidity', 'light', 'timestamp'
        ])
        && data.keys().hasOnly([
          'soilMoisture', 'soilRawADC', 'temperature', 'humidity', 'light', 'pumpStatus', 'timestamp'
        ])
        && validSensorFields(data)
        && data.timestamp is timestamp
        && (!('pumpStatus' in data) || data.pumpStatus == 'ON' || data.pumpStatus == 'OFF');
    }

    function validState(data) {
      return data.keys().hasAll([
          'soilMoisture', 'soilRawADC', 'temperature', 'humidity', 'light',
          'pumpStatus', 'autoMode', 'deviceStatus', 'lastSeen', 'timestamp'
        ])
        && data.keys().hasOnly([
          'soilMoisture', 'soilRawADC', 'temperature', 'humidity', 'light',
          'pumpStatus', 'autoMode', 'deviceStatus', 'lastSeen', 'timestamp'
        ])
        && validSensorFields(data)
        && (data.pumpStatus == 'ON' || data.pumpStatus == 'OFF')
        && data.autoMode is bool
        && data.deviceStatus == 'ONLINE'
        && data.lastSeen is timestamp
        && data.timestamp is timestamp;
    }

    function validCommand(data) {
      return data.keys().hasOnly([
          'pumpCommand', 'autoMode', 'minimumMoisture', 'targetMoisture', 'updatedAt'
        ])
        && data.updatedAt == request.time
        && (!('pumpCommand' in data) || data.pumpCommand == null
          || data.pumpCommand == 'START' || data.pumpCommand == 'STOP')
        && (!('autoMode' in data) || data.autoMode is bool)
        && (!('minimumMoisture' in data)
          || (numericValue(data.minimumMoisture) && data.minimumMoisture >= 0 && data.minimumMoisture < 100))
        && (!('targetMoisture' in data)
          || (numericValue(data.targetMoisture) && data.targetMoisture > 0 && data.targetMoisture <= 100))
        && data.get('minimumMoisture', 35) < data.get('targetMoisture', 45);
    }

    match /farms/{farmId} {
      allow read: if farmOwner(farmId);
      allow write: if false;
    }

    match /devices/{deviceId} {
      allow read: if deviceOwner(deviceId) || deviceIdentity(deviceId);
      allow create, delete: if false;
      allow update: if deviceIdentity(deviceId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deviceStatus', 'lastSeen', 'firmwareVersion', 'wifiStatus'])
        && request.resource.data.deviceStatus == 'ONLINE'
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.firmwareVersion is string
        && request.resource.data.firmwareVersion.size() > 0
        && request.resource.data.firmwareVersion.size() <= 40
        && request.resource.data.wifiStatus is string
        && request.resource.data.wifiStatus.size() <= 64;

      match /readings/{readingId} {
        allow read: if deviceOwner(deviceId);
        allow create: if deviceIdentity(deviceId) && validReading(request.resource.data);
        allow update, delete: if false;
      }

      match /state/{stateId} {
        allow read: if deviceOwner(deviceId) || deviceIdentity(deviceId);
        allow create, update: if stateId == 'current'
          && deviceIdentity(deviceId)
          && validState(request.resource.data);
        allow delete: if false;
      }

      match /commands/{commandId} {
        allow read: if deviceOwner(deviceId) || deviceIdentity(deviceId);
        allow create: if commandId == 'current' && deviceOwner(deviceId)
          && validCommand(request.resource.data);
        allow update: if commandId == 'current'
          && (
            (deviceOwner(deviceId) && validCommand(request.resource.data))
            || (deviceIdentity(deviceId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pumpCommand'])
              && request.resource.data.pumpCommand == null)
          );
        allow delete: if false;
      }
    }

    match /irrigation_history/{eventId} {
      allow read: if deviceOwner(resource.data.deviceId);
      allow create: if request.resource.data.keys().hasAll([
          'deviceId', 'action', 'reason', 'soilMoisture', 'timestamp', 'source'
        ])
        && request.resource.data.keys().hasOnly([
          'deviceId', 'action', 'reason', 'soilMoisture', 'timestamp', 'source'
        ])
        && request.resource.data.deviceId is string
        && deviceIdentity(request.resource.data.deviceId)
        && (request.resource.data.action == 'START' || request.resource.data.action == 'STOP')
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && numericValue(request.resource.data.soilMoisture)
        && request.resource.data.soilMoisture >= 0
        && request.resource.data.soilMoisture <= 100
        && request.resource.data.timestamp is timestamp
        && (request.resource.data.source == 'AUTO' || request.resource.data.source == 'MANUAL');
      allow update, delete: if false;
    }
  }
}
